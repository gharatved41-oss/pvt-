# ==============================================================================
# Vuln TWin - Environment Configuration Example
# ==============================================================================

# Core Project
PROJECT_NAME="Vuln TWin"
VERSION="1.0.0"

# Application Security
# Generate a secure 32+ character key for production: openssl rand -hex 32
VULN_TWIN_SECRET_KEY="vuln-twin-super-secure-production-secret-key-32bytes-min"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default: SQLite with foreign key pragmas and transactional safety
DATABASE_URL="sqlite:///./vuln_twin.db"

# National Vulnerability Database (NVD) API (Optional)
# If left empty, system operates in air-gapped deterministic fixture mode
NVD_API_KEY=""
NVD_API_TIMEOUT=10

# Digital Twin Provider Configuration
# Options: 'mock_isolated' (standard sandbox), 'virtualbox' (future hypervisor daemon)
TWIN_PROVIDER="mock_isolated"
TWIN_ISOLATION_NETWORK="192.168.100.0/24-isolated-lab"
MAX_VALIDATION_TIMEOUT_SECONDS=45
